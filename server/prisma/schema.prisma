// HRMS database schema — owner-only house rental management.
// Amounts use PostgreSQL NUMERIC to avoid floating-point drift on money.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PropertyType {
  HOUSE
  APARTMENT
  BEDSITTER
  STUDIO
  SHOP
  OFFICE
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OFFLINE
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
}

enum RentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  MPESA
  BANK_TRANSFER
  CHEQUE
  MOBILE_APP
  OTHER
}

enum ExpenseCategory {
  REPAIRS
  UTILITIES
  TAXES
  INSURANCE
  MANAGEMENT
  SALARIES
  OTHER
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  CONSOLE
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationEvent {
  RENT_REMINDER
  RENT_OVERDUE
  PAYMENT_RECEIVED
  LEASE_CREATED
  LEASE_EXPIRING
}

model Owner {
  id                 String   @id @default(cuid())
  email              String   @unique
  fullName           String
  phone              String?
  passwordHash       String
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  payments      Payment[]
  expenses      Expense[]
  maintenance   MaintenanceRequest[]

  @@map("owners")
}

model RefreshToken {
  id        String    @id @default(cuid())
  ownerId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("refresh_tokens")
}

model Property {
  id          String         @id @default(cuid())
  name        String
  address     String
  unitNumber  String?
  type        PropertyType   @default(HOUSE)
  bedrooms    Int?
  bathrooms   Int?
  monthlyRent Decimal        @db.Decimal(12, 2)
  deposit     Decimal        @default(0) @db.Decimal(12, 2)
  status      PropertyStatus @default(AVAILABLE)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  leases            Lease[]
  expenses          Expense[]
  maintenanceReqs   MaintenanceRequest[]

  @@unique([name, unitNumber])
  @@index([status])
  @@map("properties")
}

model Tenant {
  id               String   @id @default(cuid())
  fullName         String
  phone            String
  idNumber         String   @unique
  email            String?
  postalAddress    String?
  emergencyContact String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  leases            Lease[]
  payments          Payment[]
  maintenanceReqs   MaintenanceRequest[]
  notifications     Notification[]

  @@index([fullName])
  @@index([phone])
  @@map("tenants")
}

model Lease {
  id                   String      @id @default(cuid())
  propertyId           String
  tenantId             String
  startDate            DateTime
  endDate              DateTime?
  rentAmount           Decimal     @db.Decimal(12, 2)
  deposit              Decimal     @default(0) @db.Decimal(12, 2)
  dueDay               Int         @default(5)
  status               LeaseStatus @default(ACTIVE)
  autoGenerateSchedule Boolean     @default(true)
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  property    Property       @relation(fields: [propertyId], references: [id])
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  rentItems   RentSchedule[]
  payments    Payment[]

  @@index([status])
  @@index([tenantId])
  @@index([propertyId])
  @@map("leases")
}

model RentSchedule {
  id         String     @id @default(cuid())
  leaseId    String
  periodYear Int
  periodMonth Int
  dueDate    DateTime   @db.Date
  amount     Decimal    @db.Decimal(12, 2)
  amountPaid Decimal    @default(0) @db.Decimal(12, 2)
  status     RentStatus @default(UNPAID)
  paidAt     DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  lease    Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments Payment[]
  notifications Notification[]

  @@unique([leaseId, periodYear, periodMonth])
  @@index([dueDate])
  @@index([status])
  @@map("rent_schedules")
}

model Payment {
  id             String        @id @default(cuid())
  rentScheduleId String
  leaseId        String
  tenantId       String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  note           String?
  paidAt         DateTime
  recordedById   String
  reversed       Boolean       @default(false)
  createdAt      DateTime      @default(now())

  rentSchedule RentSchedule @relation(fields: [rentScheduleId], references: [id])
  lease        Lease        @relation(fields: [leaseId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  recordedBy   Owner        @relation(fields: [recordedById], references: [id])

  @@index([rentScheduleId])
  @@index([tenantId])
  @@index([paidAt])
  @@map("payments")
}

model Expense {
  id           String          @id @default(cuid())
  propertyId   String?
  category     ExpenseCategory
  amount       Decimal         @db.Decimal(12, 2)
  description  String
  incurredAt   DateTime        @db.Date
  createdById  String
  createdAt    DateTime        @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  createdBy Owner    @relation(fields: [createdById], references: [id])

  @@index([incurredAt])
  @@map("expenses")
}

model MaintenanceRequest {
  id          String             @id @default(cuid())
  propertyId  String
  tenantId    String?
  title       String
  description String?
  status      MaintenanceStatus  @default(OPEN)
  priority    Priority           @default(MEDIUM)
  cost        Decimal?           @db.Decimal(12, 2)
  reportedAt  DateTime           @default(now())
  resolvedAt  DateTime?
  createdById String

  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  createdBy Owner   @relation(fields: [createdById], references: [id])

  @@index([status])
  @@map("maintenance_requests")
}

model Notification {
  id         String              @id @default(cuid())
  event      NotificationEvent
  channel    NotificationChannel
  recipient  String
  recipientName String?
  subject    String
  body       String
  status     NotificationStatus  @default(PENDING)
  error      String?
  sentAt     DateTime?
  tenantId   String?
  leaseId    String?
  rentScheduleId String?
  dedupeKey  String?             @unique
  createdAt  DateTime            @default(now())

  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  rentSchedule RentSchedule? @relation(fields: [rentScheduleId], references: [id])

  @@index([event, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  ownerId    String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  owner Owner? @relation(fields: [ownerId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
