# --- runtime -------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- database ------------------------------------------------------------
# Local embedded PostgreSQL started by `npm run db:start`.
DATABASE_URL=postgresql://hrms:hrms-local@localhost:5433/hrms

# Supabase (used in production). DATABASE_URL goes through the connection
# pooler, which rejects DDL, so schema commands use DIRECT_URL instead:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=10
#   DIRECT_URL  =postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Both are available in Supabase Dashboard -> Project Settings -> Database.
# Locally, set DIRECT_URL to the same value as DATABASE_URL.
DIRECT_URL=postgresql://hrms:hrms-local@localhost:5433/hrms

# Embedded cluster settings (used only by src/scripts/db.ts)
EMBEDDED_PG_DIR=.data/postgres
EMBEDDED_PG_PORT=5433
EMBEDDED_PG_USER=hrms
EMBEDDED_PG_PASSWORD=hrms-local
EMBEDDED_PG_DATABASE=hrms

# --- auth ----------------------------------------------------------------
# REQUIRED. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- first owner account -------------------------------------------------
# Used once, when the owners table is empty. No tenant logins are created.
OWNER_BOOTSTRAP_EMAIL=owner@example.com
OWNER_BOOTSTRAP_PASSWORD=change-me-please
OWNER_BOOTSTRAP_NAME=Property Owner

# --- notifications -------------------------------------------------------
# console = log to the server output and record in the notifications table
# smtp    = real email delivery through the settings below
NOTIFICATION_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HRMS <no-reply@hrms.local>

REMINDER_DAYS_BEFORE_DUE=3
OVERDUE_REMINDER_DAYS=1

# In-process cron. Set false where the platform schedules for you (Vercel Cron
# calls GET /api/cron/reminders with `Authorization: Bearer $CRON_SECRET`).
ENABLE_SCHEDULER=true
CRON_SECRET=
